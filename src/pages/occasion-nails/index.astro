---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import SectionHeading from '../../components/SectionHeading.astro';

const pageTitle = 'Occasion Nails: Manicure Ideas for Weddings, Events & Everyday | The Nail Edit';
const pageDescription = 'Find the perfect manicure for weddings, birthdays, prom, graduation, Valentine\'s Day, and everyday life. Practical styling advice for every event dress code.';
const canonicalURL = new URL('/occasion-nails/', Astro.site || 'https://themaniedit.com');

const occasionGuides = [
  {
    name: 'Wedding Nails',
    slug: 'wedding',
    role: 'Bridal, Bridesmaid & Guest',
    stylingRule: 'Timeless restraint that complements the ring and dress fabric without overpowering photography.',
    keyPicks: ['Glazed sheer blush with micro French tip', 'Milky white with subtle mother-of-pearl shimmer', 'Clean nude almond with dainty gold foil accents'],
    recommendedTiming: '24 to 48 hours before the ceremony (or high-end press-ons the morning of)'
  },
  {
    name: 'Birthday Nails',
    slug: 'birthday',
    role: 'Personal Celebration & Statement',
    stylingRule: 'Expressive, joyful, and tailored entirely to your personal aesthetic.',
    keyPicks: ['Reflective glitter ombré with 3D chrome swirls', 'Vibrant aura blush nails with birthstone accents', 'Maximalist themed nail art on sculpted coffin tips'],
    recommendedTiming: '1 to 2 days prior to your party'
  },
  {
    name: 'Prom Nails',
    slug: 'prom',
    role: 'Formal High School Gala',
    stylingRule: 'Coordinated harmoniously with dress undertones, corsage flowers, or metallic jewelry.',
    keyPicks: ['Metallic chrome matching jewelry tones', 'Velvet cat-eye shimmer in deep jewel tones', 'Delicate lace or crystal embellishments over almond extensions'],
    recommendedTiming: '1 to 2 days before the prom dance'
  },
  {
    name: 'Graduation Nails',
    slug: 'graduation',
    role: 'Academic Milestone & Ceremony',
    stylingRule: 'Clean, elegant, and photo-ready for holding the diploma without distraction.',
    keyPicks: ['Classic soft squoval in milky rose', 'Subtle collegiate accent line on the ring finger', 'Timeless French manicure with gold micro-stripes'],
    recommendedTiming: '1 to 2 days before commencement ceremonies'
  },
  {
    name: 'Valentine\'s Day Nails',
    slug: 'valentines-day',
    role: 'Romantic Dates & Self-Love Celebrations',
    stylingRule: 'Playful romance spanning from understated micro-hearts to seductive deep crimson velvets.',
    keyPicks: ['Minimalist negative-space red hearts', 'Rose quartz marbling with gold leaf veins', 'Deep cherry-red glazed almond tips'],
    recommendedTiming: 'The week of February 14th'
  },
  {
    name: 'Everyday Nails',
    slug: 'everyday',
    role: 'Daily Routine, Work & Lifestyle',
    stylingRule: 'Comfortable, durable, and universally chic across desk work, errands, and casual weekends.',
    keyPicks: ['Short squoval in sheer neutral latte', 'Clear protective builder gel (BIAB) on natural nails', 'Soft mauve or warm taupe creme with chip-resistant topcoat'],
    recommendedTiming: 'Maintained every 2 to 3 weeks'
  }
];
---

<BaseLayout title={pageTitle} description={pageDescription} canonicalURL={canonicalURL}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6">
    <Breadcrumbs items={[{ label: 'Occasion Nails' }]} />

    <!-- HERO SECTION: Pillar 6 Single H1 -->
    <header class="pt-6 pb-12 border-b border-stone-200/80">
      <div class="max-w-3xl">
        <span class="inline-block text-xs uppercase tracking-[0.2em] font-semibold text-[#B96655] mb-2 font-sans">
          Topical Pillar &bull; Event Styling &amp; Etiquette
        </span>
        <h1 class="font-serif text-4xl sm:text-5xl lg:text-6xl font-bold tracking-tight text-[#1C1917] leading-[1.12]">
          Occasion Nails &amp; Event Manicure Styling
        </h1>
        <p class="mt-4 text-base sm:text-lg text-stone-600 leading-relaxed font-light">
          A truly exceptional manicure considers the occasion. From timeless bridal manicures photographed for posterity to high-energy birthday statements and durable everyday work looks, discover how to pair nail silhouettes and finishes with your event dress code.
        </p>
      </div>

      <div class="mt-8 flex flex-wrap gap-2">
        <span class="text-xs font-semibold uppercase tracking-wider text-stone-500 self-center mr-2">Events:</span>
        {occasionGuides.map((occ) => (
          <a href={`#${occ.slug}`} class="px-3 py-1 rounded-full text-xs font-medium bg-white border border-stone-200 hover:border-[#B96655] transition-colors">
            {occ.name}
          </a>
        ))}
      </div>
    </header>

    <!-- SECTION 1: Event Styling Principles -->
    <section class="py-12 border-b border-stone-200/80">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <div class="p-6 rounded-2xl bg-white border border-stone-200/80">
          <span class="text-xs font-mono uppercase tracking-wider text-[#B96655] font-semibold">01 / Fabric Harmony</span>
          <h2 class="font-serif text-xl font-bold text-[#1C1917] mt-1 mb-2">Wardrobe Palette Sync</h2>
          <p class="text-xs text-stone-600 leading-relaxed">
            Your polish should support your ensemble rather than compete against it. If wearing intricate sequined lace, opt for clean sheer nails; if wearing minimalist slip dresses, let statement chrome or bold red take the spotlight.
          </p>
        </div>
        <div class="p-6 rounded-2xl bg-white border border-stone-200/80">
          <span class="text-xs font-mono uppercase tracking-wider text-[#B96655] font-semibold">02 / Photography</span>
          <h2 class="font-serif text-xl font-bold text-[#1C1917] mt-1 mb-2">Flash &amp; Lighting Demands</h2>
          <p class="text-xs text-stone-600 leading-relaxed">
            High-contrast flash photography can make harsh stark whites look unnatural on camera. For weddings and graduations, soft coconut milks and translucent blush tones photograph with soft, natural depth.
          </p>
        </div>
        <div class="p-6 rounded-2xl bg-white border border-stone-200/80">
          <span class="text-xs font-mono uppercase tracking-wider text-[#B96655] font-semibold">03 / Longevity</span>
          <h2 class="font-serif text-xl font-bold text-[#1C1917] mt-1 mb-2">Timing Your Appointment</h2>
          <p class="text-xs text-stone-600 leading-relaxed">
            Schedule your professional manicure 1 to 2 days before major ceremonies to guarantee peak high-gloss shine while avoiding fresh cuticle redness or accidental travel chips.
          </p>
        </div>
      </div>
    </section>

    <!-- SECTION 2: The 6 Event Guides -->
    <section class="py-14">
      <SectionHeading
        kicker="EVENT DIRECTORY"
        title="Curated Event Guides"
        subtitle="Styling rules, signature manicure picks, and recommended scheduling for major calendar milestones."
      />

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {occasionGuides.map((occ) => (
          <article 
            id={occ.slug}
            class="p-7 rounded-2xl bg-white border border-stone-200/80 flex flex-col justify-between editorial-card-shadow editorial-card-hover"
          >
            <div>
              <span class="text-[10px] uppercase tracking-wider font-semibold px-2.5 py-1 rounded-full bg-stone-100 text-[#B96655]">
                {occ.role}
              </span>
              <h2 class="font-serif text-2xl font-bold text-[#1C1917] mt-3 mb-2">
                {occ.name}
              </h2>
              <p class="text-xs text-stone-600 leading-relaxed mb-4">
                <strong>Styling Concept:</strong> {occ.stylingRule}
              </p>

              <div class="pt-3 border-t border-stone-100 space-y-2 mb-4">
                <span class="block text-[11px] font-bold uppercase tracking-wider text-stone-800">
                  Top Manicure Picks:
                </span>
                <ul class="space-y-1.5">
                  {occ.keyPicks.map((pick) => (
                    <li class="text-xs text-stone-600 flex items-start gap-2">
                      <span class="w-1.5 h-1.5 rounded-full bg-[#B96655] mt-1 flex-shrink-0"></span>
                      <span>{pick}</span>
                    </li>
                  ))}
                </ul>
              </div>

              <div class="pt-3 border-t border-stone-100 text-xs text-stone-500">
                <strong class="text-stone-800">Best Timing:</strong> {occ.recommendedTiming}
              </div>
            </div>

            <div class="mt-6 pt-3 border-t border-stone-100 flex items-center justify-between text-xs text-stone-500">
              <span>Event Inspo Guide</span>
              <span class="text-[#B96655] font-semibold">Planned &rarr;</span>
            </div>
          </article>
        ))}
      </div>
    </section>

    <!-- SECTION 3: Cross-Silo Connections -->
    <section class="py-12 border-t border-stone-200/80">
      <SectionHeading
        kicker="CONNECTED INSPIRATION"
        title="Complete Your Event Look"
        subtitle="Explore specific art techniques or choose the right medium for your schedule."
      />
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-6">
        <a href="/nail-designs/" class="p-5 rounded-xl bg-white border border-stone-200 hover:border-[#B96655] transition-colors group">
          <span class="text-[10px] uppercase font-bold text-stone-400">Design Ideas</span>
          <h3 class="font-serif text-lg font-bold text-[#1C1917] group-hover:text-[#B96655] transition-colors mt-1">Nail Designs Gallery</h3>
          <p class="text-xs text-stone-600 mt-1">Explore French tips, chrome glazes, and ombré fades ideal for special events.</p>
        </a>
        <a href="/nail-types/" class="p-5 rounded-xl bg-white border border-stone-200 hover:border-[#B96655] transition-colors group">
          <span class="text-[10px] uppercase font-bold text-stone-400">Enhancements</span>
          <h3 class="font-serif text-lg font-bold text-[#1C1917] group-hover:text-[#B96655] transition-colors mt-1">Nail Types &amp; Press-Ons</h3>
          <p class="text-xs text-stone-600 mt-1">Discover quick reusable press-ons for single-night events without salon visits.</p>
        </a>
        <a href="/nail-colors/" class="p-5 rounded-xl bg-white border border-stone-200 hover:border-[#B96655] transition-colors group">
          <span class="text-[10px] uppercase font-bold text-stone-400">Color Palette</span>
          <h3 class="font-serif text-lg font-bold text-[#1C1917] group-hover:text-[#B96655] transition-colors mt-1">Explore Polish Colors</h3>
          <p class="text-xs text-stone-600 mt-1">Match blush pinks, cherry reds, or sheer neutrals to your outfit undertones.</p>
        </a>
      </div>
    </section>
  </div>
</BaseLayout>
