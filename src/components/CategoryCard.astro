---
import type { SiloItem } from '../data/silos';

interface Props {
  silo: SiloItem;
  index: number;
}

const { silo, index } = Astro.props;

// Editorial icon glyphs tailored to nail pillars
const icons: Record<string, string> = {
  sparkles: 'M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.286L13 21l-2.286-6.714L5 12l5.714-2.286L13 3z',
  shapes: 'M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z',
  palette: 'M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343M11 7.343l1.657-1.657a2 2 0 012.828 0l2.829 2.829a2 2 0 010 2.828l-8.486 8.485M7 17h.01',
  layers: 'M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10',
  heart: 'M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z',
  calendar: 'M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z',
  sun: 'M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z',
  tag: 'M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z'
};

const iconPath = icons[silo.icon] || icons.sparkles;
---

<a 
  href={silo.href}
  class="group relative flex flex-col justify-between p-6 sm:p-7 rounded-2xl bg-white border border-stone-200/80 editorial-card-shadow editorial-card-hover focus:outline-none focus-visible:ring-2 focus-visible:ring-[#B96655]"
>
  <div>
    <!-- Top Row: Counter & Icon -->
    <div class="flex items-center justify-between mb-5">
      <span class="inline-flex items-center justify-center w-10 h-10 rounded-xl bg-[#F7F3EE] text-[#1C1917] group-hover:bg-[#1C1917] group-hover:text-white transition-colors">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d={iconPath} />
        </svg>
      </span>
      <span class="text-[11px] font-mono tracking-widest text-stone-400 uppercase">
        0{index + 1}
      </span>
    </div>

    <!-- Silo Tag & Title -->
    <span class="inline-block text-[11px] uppercase tracking-[0.18em] font-semibold text-[#B96655] mb-1 font-sans">
      {silo.tag}
    </span>
    <h3 class="font-serif text-xl sm:text-2xl font-bold text-[#1C1917] group-hover:text-[#B96655] transition-colors">
      {silo.name}
    </h3>

    <!-- Description (Exact SEO copy from prompt) -->
    <p class="mt-2.5 text-stone-600 text-sm leading-relaxed">
      {silo.description}
    </p>
  </div>

  <!-- Bottom Action Link -->
  <div class="mt-6 pt-4 border-t border-stone-100 flex items-center justify-between text-xs font-semibold uppercase tracking-wider text-stone-800 group-hover:text-[#B96655] transition-colors">
    <span>Explore Pillar</span>
    <svg class="w-4 h-4 transform group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
    </svg>
  </div>
</a>
