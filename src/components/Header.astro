---
import { MAIN_SILOS } from '../data/silos';

const currentPath = Astro.url.pathname;
---

<header class="sticky top-0 z-40 w-full border-b border-stone-200/80 bg-[#FAF8F5]/90 backdrop-blur-md transition-all">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-20">
      <!-- Site Logo / Brand -->
      <div class="flex-shrink-0">
        <a 
          href="/" 
          class="group inline-flex items-center gap-2.5 focus:outline-none focus-visible:ring-2 focus-visible:ring-[#B96655] rounded-md py-1"
          aria-label="The Mani Edit - Return to homepage"
        >
          <span class="w-8 h-8 rounded-full bg-[#1C1917] text-[#FAF8F5] flex items-center justify-center font-serif text-lg font-medium tracking-tighter group-hover:bg-[#B96655] transition-colors">
            M
          </span>
          <div class="flex flex-col">
            <span class="font-serif text-2xl font-bold tracking-tight text-[#1C1917] group-hover:text-[#B96655] transition-colors">
              The Mani Edit
            </span>
            <span class="text-[10px] tracking-[0.2em] uppercase text-stone-500 font-medium">
              Curated Nail Inspiration
            </span>
          </div>
        </a>
      </div>

      <!-- Desktop Primary Silo Navigation -->
      <nav 
        class="hidden xl:flex items-center space-x-1 lg:space-x-1" 
        aria-label="Main Navigation"
      >
        {MAIN_SILOS.map((silo) => {
          const isActive = currentPath === silo.href || currentPath.startsWith(silo.href);
          return (
            <a
              href={silo.href}
              class={`px-2.5 py-2 text-xs uppercase tracking-wider font-semibold rounded-md transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-[#B96655] ${
                isActive 
                  ? 'text-[#B96655] bg-stone-100/80 font-bold' 
                  : 'text-stone-700 hover:text-[#1C1917] hover:bg-stone-100/60'
              }`}
            >
              {silo.name}
            </a>
          );
        })}
      </nav>

      <!-- Search / Action / Quick Jump & Mobile Menu Button -->
      <div class="flex items-center gap-3">
        <a
          href="/nail-designs/"
          class="hidden sm:inline-flex items-center gap-1.5 px-4 py-2 text-xs font-semibold uppercase tracking-wider text-white bg-[#1C1917] hover:bg-[#B96655] rounded-full transition-colors shadow-sm focus:outline-none focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-[#B96655]"
        >
          Browse Designs
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </a>

        <!-- Zero-JS Accessible Mobile Menu via Details -->
        <details class="xl:hidden group relative">
          <summary 
            class="list-none cursor-pointer p-2 rounded-md text-stone-700 hover:text-[#1C1917] hover:bg-stone-100 focus:outline-none focus-visible:ring-2 focus-visible:ring-[#B96655]"
            aria-label="Toggle navigation menu"
          >
            <!-- Hamburger Icon (closed) -->
            <svg class="w-6 h-6 group-open:hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
            </svg>
            <!-- Close Icon (open) -->
            <svg class="w-6 h-6 hidden group-open:block text-[#B96655]" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
            </svg>
          </summary>

          <!-- Dropdown Navigation Sheet -->
          <div class="absolute right-0 mt-3 w-72 max-h-[85vh] overflow-y-auto rounded-2xl bg-white border border-stone-200/90 shadow-2xl p-4 z-50 animate-in fade-in slide-in-from-top-2">
            <div class="pb-3 mb-3 border-b border-stone-100">
              <p class="text-xs font-semibold uppercase tracking-wider text-stone-400">Topical Silos</p>
            </div>
            <nav class="flex flex-col space-y-1" aria-label="Mobile Silo Directory">
              {MAIN_SILOS.map((silo) => (
                <a
                  href={silo.href}
                  class="flex items-center justify-between px-3 py-2.5 rounded-lg text-sm font-medium text-stone-800 hover:bg-[#FAF8F5] hover:text-[#B96655] transition-colors"
                >
                  <span>{silo.name}</span>
                  <span class="text-[10px] uppercase font-semibold text-stone-400 tracking-wider bg-stone-100 px-2 py-0.5 rounded">
                    {silo.tag}
                  </span>
                </a>
              ))}
            </nav>
            <div class="pt-4 mt-4 border-t border-stone-100">
              <a
                href="/nail-care/"
                class="block w-full py-2.5 text-center text-xs font-semibold uppercase tracking-wider bg-[#FAF8F5] border border-stone-200 text-stone-700 rounded-xl hover:bg-stone-100 transition-colors"
              >
                Nail Care Guides
              </a>
            </div>
          </div>
        </details>
      </div>
    </div>
  </div>
</header>
