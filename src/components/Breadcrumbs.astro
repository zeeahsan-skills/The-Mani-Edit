---
export interface BreadcrumbItem {
  label: string;
  href?: string;
}

interface Props {
  items: BreadcrumbItem[];
}

const { items } = Astro.props;
---

<nav aria-label="Breadcrumb" class="py-4">
  <ol class="flex flex-wrap items-center gap-1.5 text-xs text-stone-500">
    <li class="inline-flex items-center">
      <a 
        href="/" 
        class="hover:text-[#B96655] transition-colors inline-flex items-center gap-1"
      >
        <svg class="w-3.5 h-3.5 text-stone-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
        </svg>
        <span>Home</span>
      </a>
    </li>

    {items.map((item, index) => {
      const isLast = index === items.length - 1;
      return (
        <li class="inline-flex items-center gap-1.5">
          <span class="text-stone-300 select-none" aria-hidden="true">/</span>
          {isLast || !item.href ? (
            <span class="text-stone-900 font-semibold" aria-current="page">
              {item.label}
            </span>
          ) : (
            <a 
              href={item.href} 
              class="hover:text-[#B96655] transition-colors"
            >
              {item.label}
            </a>
          )}
        </li>
      );
    })}
  </ol>
</nav>
