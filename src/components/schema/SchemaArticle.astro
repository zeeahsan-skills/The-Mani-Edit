---
interface Props {
  headline: string;
  description: string;
  datePublished: Date | string;
  dateModified?: Date | string;
  image?: string;
  canonicalUrl: string;
}

const {
  headline,
  description,
  datePublished,
  dateModified,
  image = 'https://nailedits.site/images/the-nail-edit-og.jpg',
  canonicalUrl,
} = Astro.props;

const schemaData = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': canonicalUrl,
  },
  headline,
  description,
  image: image.startsWith('http') ? image : `https://nailedits.site${image}`,
  datePublished: new Date(datePublished).toISOString(),
  dateModified: dateModified ? new Date(dateModified).toISOString() : new Date(datePublished).toISOString(),
  author: {
    '@type': 'Organization',
    name: 'The Nail Edit Editorial Team',
    url: 'https://nailedits.site/about/',
  },
  publisher: {
    '@type': 'Organization',
    name: 'The Nail Edit',
    url: 'https://nailedits.site/',
    logo: {
      '@type': 'ImageObject',
      url: 'https://nailedits.site/favicon.svg',
    },
  },
};
---

<script is:inline type="application/ld+json" set:html={JSON.stringify(schemaData)} />
