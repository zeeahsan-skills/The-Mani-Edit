---
export interface HowToStep {
  name: string;
  text: string;
  url?: string;
  image?: string;
}

interface Props {
  name: string;
  description: string;
  steps?: HowToStep[];
  totalTime?: string; // e.g. "PT30M"
}

const { name, description, steps, totalTime } = Astro.props;

if (!steps || steps.length === 0) {
  return null;
}

const schemaData = {
  '@context': 'https://schema.org',
  '@type': 'HowTo',
  name,
  description,
  totalTime,
  step: steps.map((step, index) => ({
    '@type': 'HowToStep',
    position: index + 1,
    name: step.name,
    text: step.text,
    url: step.url,
    image: step.image,
  })),
};
---

<script is:inline type="application/ld+json" set:html={JSON.stringify(schemaData)} />
