---
import SectionHeading from './SectionHeading.astro';

// Reusable component prepared for future Astro Content Collections integration
interface CollectionPreviewItem {
  title: string;
  silo: string;
  href: string;
  summary: string;
  status: string;
}

const previewSlots: CollectionPreviewItem[] = [
  {
    title: 'The Essential Almond Nail Silhouette Guide',
    silo: 'Nail Shapes',
    href: '/nail-shapes/',
    summary: 'Proportion rules, apex shaping tips, and length recommendations for almond manicures.',
    status: 'Upcoming Editorial'
  },
  {
    title: 'Glazed & Chrome Finishes: Technique Breakdown',
    silo: 'Nail Designs',
    href: '/nail-designs/',
    summary: 'Achieving translucent mirror sheen with chrome powders over gel and regular polish.',
    status: 'Upcoming Editorial'
  },
  {
    title: 'Cuticle Oil Chemistry & Daily Nail Bed Care',
    silo: 'Nail Care',
    href: '/nail-care/',
    summary: 'Jojoba oil penetration, matrix hydration, and preventing hangnails and brittle splits.',
    status: 'Upcoming Editorial'
  }
];
---

<section class="py-16 sm:py-20 border-t border-stone-200/80 bg-white" aria-labelledby="featured-heading">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div id="featured-heading">
      <SectionHeading
        kicker="CONTENT PREVIEW ARCHITECTURE"
        title="Featured Nail Guides & Edits"
        subtitle="This reusable section is architected to connect directly with Astro Content Collections as new in-depth guides are published."
        linkText="View All Silos"
        linkHref="/nail-designs/"
      />
    </div>

    <!-- Collection Preview Grid (Clean placeholder state, zero fake dates or claims) -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      {previewSlots.map((item) => (
        <article class="relative flex flex-col justify-between p-6 rounded-2xl bg-[#FAF8F5] border border-stone-200/90 editorial-card-hover">
          <div>
            <!-- Pill Status Badge -->
            <div class="flex items-center justify-between mb-4">
              <span class="text-[10px] font-semibold uppercase tracking-wider text-[#B96655] bg-[#EFE4DC]/60 px-2.5 py-1 rounded-full">
                {item.silo}
              </span>
              <span class="text-[10px] uppercase font-mono tracking-wider text-stone-400">
                {item.status}
              </span>
            </div>

            <h3 class="font-serif text-xl font-bold text-[#1C1917] mb-2 leading-snug">
              {item.title}
            </h3>

            <p class="text-xs text-stone-600 leading-relaxed">
              {item.summary}
            </p>
          </div>

          <div class="mt-6 pt-4 border-t border-stone-200/60 flex items-center justify-between">
            <span class="text-[11px] text-stone-400 font-medium">
              Collection Slot
            </span>
            <a 
              href={item.href}
              class="inline-flex items-center gap-1 text-xs font-semibold text-stone-800 hover:text-[#B96655] transition-colors"
            >
              <span>Explore Silo</span>
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
              </svg>
            </a>
          </div>
        </article>
      ))}
    </div>

    <!-- Architectural Note Box -->
    <div class="mt-8 p-4 rounded-xl bg-stone-50 border border-stone-200/60 flex items-center gap-3 text-xs text-stone-600">
      <svg class="w-5 h-5 text-stone-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
      </svg>
      <span>
        Built ready for <code class="font-mono bg-white px-1.5 py-0.5 rounded border border-stone-200 text-stone-700">getCollection('articles')</code>. Clean foundation ready for future editorial releases without altering homepage hierarchy.
      </span>
    </div>
  </div>
</section>
